		{
			"id": "BoZQlTnt",
			"type": "text",
			"x": -590,
			"y": 245,
			"width": 282.1138610839844,
			"height": 427.5,
			"angle": 0,
			"strokeColor": "#004d40",
			"backgroundColor": "transparent",
			"fillStyle": "solid",
			"strokeWidth": 1,
			"strokeStyle": "solid",
