    {
      "id": "n-root",
      "label": "构建 Claude 技能",
      "type": "topic",
      "summary": "把可重复工作流沉淀为可加载、可测试、可分发的技能。",
      "note": "核心主题：技能 = 指令文件夹 + 渐进式披露 + 可执行工作流。",
      "discussion_prompt": "基于这张图，帮我设计一个具体技能的 SKILL.md 结构。",
      "source": "/Users/saaaaa/Obsidian-Template/raw/1/google-drive-pdf-1QR-Pq-KB/claude-skills-building-guide.md",
      "priority": "high",
      "status": "understood"
    },
    {
      "id": "n-intro",
      "label": "技能定位",
      "type": "concept",
      "summary": "技能教 Claude 按特定任务或工作流稳定执行。",
      "note": "适合前端设计、研究、文档创建、多步骤流程，以及 MCP 工具编排。",
      "discussion_prompt": "",
      "source": "/Users/saaaaa/Obsidian-Template/raw/1/google-drive-pdf-1QR-Pq-KB/claude-skills-building-guide.md",
      "priority": "high",
      "status": "understood"
    },
    {
      "id": "n-basics",
      "label": "基础结构",
      "type": "concept",
      "summary": "技能目录由必需的 SKILL.md 和可选资源组成。",
      "note": "典型组成：SKILL.md、scripts/、references/、assets/。",
      "discussion_prompt": "",
      "source": "/Users/saaaaa/Obsidian-Template/raw/1/google-drive-pdf-1QR-Pq-KB/claude-skills-building-guide.md",
      "priority": "high",
      "status": "understood"
    },
    {
      "id": "n-design",
      "label": "规划设计",
      "type": "concept",
      "summary": "先定义用例、触发词、步骤和成功结果，再写文件。",
      "note": "推荐先确定 2-3 个具体用例。",
      "discussion_prompt": "帮我把一个模糊需求拆成技能用例、触发词和工作流步骤。",
      "source": "/Users/saaaaa/Obsidian-Template/raw/1/google-drive-pdf-1QR-Pq-KB/claude-skills-building-guide.md",
      "priority": "high",
      "status": "understood"
    },
    {
      "id": "n-testing",
      "label": "测试迭代",
      "type": "action",
      "summary": "通过触发、功能和效率测试持续修正技能。",
      "note": "测试层级：手动测试、Claude Code 脚本化测试、Skills API 程序化测试。",
      "discussion_prompt": "",
      "source": "/Users/saaaaa/Obsidian-Template/raw/1/google-drive-pdf-1QR-Pq-KB/claude-skills-building-guide.md",
      "priority": "high",
      "status": "understood"
    },
    {
      "id": "n-distribution",
      "label": "分发共享",
      "type": "concept",
      "summary": "技能需要清晰安装、启用、测试和定位说明。",
      "note": "推荐托管在 GitHub，README 写清价值、安装和示例。",
      "discussion_prompt": "",
      "source": "/Users/saaaaa/Obsidian-Template/raw/1/google-drive-pdf-1QR-Pq-KB/claude-skills-building-guide.md",
      "priority": "medium",
      "status": "understood"
    },
    {
      "id": "n-patterns",
      "label": "模式排障",
      "type": "concept",
      "summary": "常见工作流模式帮助技能从工具清单变成问题解决方案。",
      "note": "包括顺序编排、多 MCP 协调、迭代优化、上下文选择和领域智能。",
      "discussion_prompt": "",
      "source": "/Users/saaaaa/Obsidian-Template/raw/1/google-drive-pdf-1QR-Pq-KB/claude-skills-building-guide.md",
      "priority": "high",
      "status": "understood"
    },
    {
      "id": "n-resources",
      "label": "资源清单",
      "type": "source",
