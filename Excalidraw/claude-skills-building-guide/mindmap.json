      "priority": "medium",
      "status": "understood"
    },
    {
      "id": "n-repeatable",
      "label": "可重复工作流",
      "type": "concept",
      "summary": "技能最适合反复出现、需要一致方法的任务。",
      "note": "不要为一次性、无稳定流程的任务过度设计技能。",
      "discussion_prompt": "",
      "source": "/Users/saaaaa/Obsidian-Template/raw/1/google-drive-pdf-1QR-Pq-KB/claude-skills-building-guide.md",
      "priority": "medium",
      "status": "understood"
    },
    {
      "id": "n-mcp-layer",
      "label": "MCP 知识层",
      "type": "concept",
      "summary": "MCP 提供连接性，技能提供如何使用工具的知识。",
      "note": "厨房类比：MCP 是厨房，技能是食谱。",
      "discussion_prompt": "",
      "source": "/Users/saaaaa/Obsidian-Template/raw/1/google-drive-pdf-1QR-Pq-KB/claude-skills-building-guide.md",
      "priority": "high",
      "status": "understood"
    },
    {
      "id": "n-skill-md",
      "label": "SKILL.md",
      "type": "concept",
      "summary": "必需主文件，包含 frontmatter 和技能正文。",
      "note": "frontmatter 用于触发判断；正文用于执行说明。",
      "discussion_prompt": "",
      "source": "/Users/saaaaa/Obsidian-Template/raw/1/google-drive-pdf-1QR-Pq-KB/claude-skills-building-guide.md",
      "priority": "high",
      "status": "understood"
    },
    {
      "id": "n-progressive",
      "label": "渐进式披露",
      "type": "concept",
      "summary": "把信息分为 frontmatter、正文和按需文件三层。",
      "note": "目标是降低上下文占用，同时保留专业能力。",
      "discussion_prompt": "",
      "source": "/Users/saaaaa/Obsidian-Template/raw/1/google-drive-pdf-1QR-Pq-KB/claude-skills-building-guide.md",
      "priority": "high",
      "status": "understood"
    },
    {
      "id": "n-composable",
      "label": "可组合可移植",
      "type": "concept",
      "summary": "技能应能与其他技能共存，并跨 Claude.ai、Claude Code、API 使用。",
      "note": "不要假设当前技能是唯一能力。",
